{
  "name": "Custom Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1E1E",
    "editor.foreground": "#DCDCDC",
    "editorLineNumber.foreground": "#555555",
    "editorLineNumber.activeForeground": "#888888",
    "editor.lineHighlightBackground": "#1A1A1A",
    "editor.selectionBackground": "#2A2A2A"
  },
  "tokenColors": [
        {
          "name": "Python keywords (def, class, return)",
          "scope": [
            "storage.type.class.python",
            "storage.type.function.python",
            "keyword.control.flow.python",
            "keyword.control.import.python"
          ],
          "settings": {
            "foreground": "#FF6961" 
          }
        },
        {
            "name": "Python Function",
            "scope": ["entity.name.function", "meta.function-call.generic.python"],
            "settings": {
                "foreground": "#D891EF"
            }
        },
        {
          "name": "Python Operators",
          "scope": [
              "keyword.operator",
              "punctuation.definition.parameters",
              "punctuation.section.group",
              "punctuation.separator.annotation",
              "punctuation.separator.key-value",
              "keyword.operator.ternary",
              "punctuation.separator.type",
              "punctuation.separator.dictionary",
              "punctuation.section.block.begin.python",
              "punctuation.definition.parameters.python",
              "punctuation.separator.comma",
              "punctuation.separator.comma.python",
              "punctuation.separator.parameters.python",
              "punctuation.section.function.begin.python",
              "punctuation.separator.colon.python",
              "punctuation.definition.arguments.begin.python",
              "punctuation.definition.arguments.end.python",
              "punctuation.separator.arguments.python",
              "support.function.builtin.python",
              "constant.language.python",
              "punctuation.section.class.begin.python",
              "punctuation.separator.period.python",
              "punctuation.definition.list.begin.python",
              "punctuation.definition.list.end.python",
              "punctuation.parenthesis.begin.python",
              "punctuation.parenthesis.end.python"
          ],
          "settings": {
              "foreground": "#DCDCDC" 
          }
        },
        {
          "name": "Python Numbers",
          "scope": ["constant.numeric.dec.python"],
          "settings": {
              "foreground": "#FFA500"
          }
        },
        {
          "name": "Python Class Name",
          "scope": ["entity.name.type.class.python"],
          "settings": {
              "foreground": "#C0C0C0"
          }
        },
        {
          "name": "Python Self",
          "scope": [
              "variable.language.special.self.python",
              "variable.parameter.function.language.special.self.python"
          ],
          "settings": {
              "foreground": "#EEDC5B"
          }
        },
        {
          "name": "Python Type",
          "scope": [
              "support.type.python"
          ],
          "settings": {
              "foreground": "#98fb98"
          }
        },
        {
          "name": "Strings",
          "scope": "string",
          "settings": {
            "foreground": "#FF9CCE"
          }
        },
        {
          "name": "Comments",
          "scope": "comment.line.number-sign.python",
          "settings": {
            "foreground": "#808080"
          }
        },
        {
            "name": "Python Function Parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "source.python"
            ],
            "settings": {
                "foreground": "#74C7EC"
            }
        }
    ]
}